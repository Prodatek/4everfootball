NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://fourever:fourever@localhost:5432/fourever?schema=public"

JWT_ACCESS_SECRET="change-me-to-a-random-32-plus-char-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-random-32-plus-char-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

WEB_APP_URL="http://localhost:3000"

# S3-compatible storage (MinIO locally via docker-compose; swap these for a
# real provider's endpoint/credentials in production, no code changes needed)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="fourever"
S3_SECRET_ACCESS_KEY="fourever123"
S3_BUCKET="media"
S3_PUBLIC_URL="http://localhost:9000/media"

MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="dev_meili_master_key"

# Payments (Phase 2, MONETISATION_BUILD_BRIEF.md) — optional. Every
# non-payment route works without these; PaystackService only throws once
# something actually tries to initialize a payment or verify a webhook
# without them set. Get real test keys from your Paystack dashboard.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
BUSINESS_NAME="4EverFootball"
BUSINESS_RC_NUMBER=
BUSINESS_BANK_NAME=
BUSINESS_ACCOUNT_NAME=
BUSINESS_ACCOUNT_NUMBER=
INVOICE_PREFIX="4EV"
APP_PUBLIC_URL="https://4ever.buildspecs.io"
