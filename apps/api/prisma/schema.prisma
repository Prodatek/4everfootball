generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SCOUT
  EDITOR
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  roles        Role[]   @default([USER])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens              RefreshToken[]
  recordedMatchEvents        MatchEvent[]
  newsArticles               NewsArticle[]
  uploadedMedia              Media[]
  organisationMembers        OrganisationMember[]
  confirmedPayments          Payment[]            @relation("PaymentConfirmedBy")
  createdPlayerOutcomes      PlayerOutcome[]
  grantedSponsorEntitlements SponsorEntitlement[]
  recordedAcademyAttendance  AcademyAttendance[]

  @@map("users")
}

// ===== Phase 2 (MONETISATION_BUILD_BRIEF.md): organisations & tenancy =====
//
// The brief lists competition-organiser org types only (ORGANISER|ACADEMY|
// SCHOOL_LEAGUE|FEDERATION) but its own club self-registration flow (§3.4)
// needs clubs to be payers too — "every competition, academy, invoice and
// payment hangs off organisation_id" only holds if a club paying for player
// registrations has an organisation_id to hang off of. CLUB is added here to
// make that actually work, not left as an unstated gap.
enum OrganisationType {
  ORGANISER
  ACADEMY
  SCHOOL_LEAGUE
  FEDERATION
  CLUB
}

enum OrganisationMemberRole {
  OWNER
  ADMIN
  RECORDER
  VIEWER
  // Phase 4 (brief §5.2): academy coach accounts. Scoped to the academy
  // organisation like every other membership role, not a separate account
  // type — a coach is a member of the academy's organisation, same as a
  // club RECORDER is a member of the club's.
  COACH
}

model Organisation {
  id          String           @id @default(uuid())
  name        String
  type        OrganisationType
  contactName String?
  phone       String?
  email       String?
  address     String?
  rcNumber    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members                     OrganisationMember[]
  competitions                Competition[]
  teams                       Team[]
  payments                    Payment[]
  invoices                    Invoice[]
  mediaPackEntitlements       MediaPackEntitlement[]
  sponsorEntitlements         SponsorEntitlement[]
  academyAgeGroups            AcademyAgeGroup[]
  academyAttendance           AcademyAttendance[]
  academySubscriptions        AcademySubscription[]
  academySubscriptionRequests AcademySubscriptionRequest[]

  @@map("organisations")
}

model OrganisationMember {
  id             String                 @id @default(uuid())
  organisationId String
  organisation   Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganisationMemberRole
  createdAt      DateTime               @default(now())

  @@unique([organisationId, userId])
  @@index([userId])
  @@map("organisation_members")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  createdByIp  String?

  @@index([userId])
  @@map("refresh_tokens")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  shortName   String?
  slug        String   @unique
  country     String?
  foundedYear Int?
  logoUrl     String?
  venueName   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Phase 4 (brief §5.1): "communities/LGAs covered" sponsor-dashboard
  // metric. Nullable, not backfilled — no existing team has ever recorded
  // this.
  community String?

  // Nullable and NOT backfilled — every team that exists today was created
  // by an admin, not by a club self-registering (that flow is new in Phase
  // 2). Stays null until a club account claims/creates the team through the
  // registration flow; SetNull (not Restrict) since unlinking a team from a
  // deleted club account shouldn't be blocked the way money records are.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  // Phase 4 (brief §5.2): links a squad to its academy age group. Nullable —
  // most teams are competition club sides with no academy concept at all.
  ageGroupId String?
  ageGroup   AcademyAgeGroup? @relation(fields: [ageGroupId], references: [id], onDelete: SetNull)

  players             Player[]
  competitionEntries  CompetitionEntry[]
  homeFixtures        Fixture[]            @relation("HomeFixtures")
  awayFixtures        Fixture[]            @relation("AwayFixtures")
  matchEvents         MatchEvent[]
  playerRegistrations PlayerRegistration[]

  @@index([country])
  @@index([organisationId])
  @@index([ageGroupId])
  @@map("teams")
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}

// Phase 4 (brief §5.1): "players by age group and gender" impact-report
// breakdown.
enum Gender {
  MALE
  FEMALE
  OTHER
}

model Player {
  id            String          @id @default(uuid())
  firstName     String
  lastName      String
  slug          String          @unique
  dateOfBirth   DateTime?
  nationality   String?
  position      PlayerPosition?
  shirtNumber   Int?
  heightCm      Int?
  preferredFoot PreferredFoot?
  photoUrl      String?
  gender        Gender?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  matchEventsAsPlayer MatchEvent[]         @relation("MatchEventPlayer")
  matchEventsAsAssist MatchEvent[]         @relation("MatchEventAssist")
  registrations       PlayerRegistration[]
  outcomes            PlayerOutcome[]
  academyAttendance   AcademyAttendance[]

  @@index([teamId])
  @@index([nationality])
  @@map("players")
}

enum CompetitionType {
  LEAGUE
  CUP
  TOURNAMENT
}

enum CompetitionTier {
  COMMUNITY
  LEAGUE
  CHAMPIONSHIP
  FEDERATION
}

enum LicenceStatus {
  DRAFT
  AWAITING_DEPOSIT
  LICENSED
  ACTIVE
  CLOSED
  SUSPENDED
}

model Competition {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  type      CompetitionType @default(LEAGUE)
  country   String?
  season    String
  startDate DateTime?
  endDate   DateTime?
  logoUrl   String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Media engine branding (Phase 3, brief §4: "configurable per competition
  // and applied automatically"). Nullable — unset competitions render
  // graphics with the platform's own Floodlight palette as a default rather
  // than a blank/broken template.
  primaryColor   String?
  secondaryColor String?
  sponsorLogoUrl String?

  // Phase 4 (brief §5.1): sponsor-dashboard "digital reach" metric.
  // Incremented in CompetitionsService.getBySlug() — an approximation
  // (counts API calls to the public endpoint, not unique client page
  // loads; there is no client-side analytics pipeline in this codebase).
  pageViewCount Int @default(0)

  // Every competition belongs to an organisation now (was a bare global
  // entity before Phase 2) — NOT NULL because the migration backfills every
  // existing row to a seeded "legacy" organisation before this constraint is
  // applied; see migration 2_organisations_and_money. Restrict: an
  // organisation with competitions can't be deleted out from under them.
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  // Licensing/entitlements (brief §3.3). Existing competitions are
  // backfilled as tier=FEDERATION/licenceStatus=ACTIVE/maxTeams=null — i.e.
  // grandfathered in as already-licensed with no limits, since they're real,
  // already-public data that never agreed to a paywall that didn't exist
  // when they were created. New competitions default to COMMUNITY/DRAFT.
  tier                 CompetitionTier @default(COMMUNITY)
  licenceStatus        LicenceStatus   @default(DRAFT)
  licensedUntil        DateTime?
  maxTeams             Int?
  registrationFeeKobo  Int?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?

  entries               CompetitionEntry[]
  fixtures              Fixture[]
  playerRegistrations   PlayerRegistration[]
  graphics              Graphic[]
  mediaPackEntitlements MediaPackEntitlement[]
  sponsorEntitlements   SponsorEntitlement[]

  @@index([country])
  @@index([season])
  @@index([organisationId])
  @@map("competitions")
}

model CompetitionEntry {
  id            String      @id @default(uuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now())

  @@unique([competitionId, teamId])
  @@index([teamId])
  @@map("competition_entries")
}

// The actual "squad" granularity the brief's registration flow needs.
// CompetitionEntry (above) is team-level; payment is per-player ("a club
// can pay for 15 of 20 players; only the paid 15 become eligible" — §3.4),
// so eligibility has to be tracked per (competition, player), not per team.
enum RegistrationStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  LOCKED
}

model PlayerRegistration {
  id            String             @id @default(uuid())
  competitionId String
  competition   Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status        RegistrationStatus @default(DRAFT)
  // Snapshotted at creation from pricing.ts, same reasoning as
  // Competition.registrationFeeKobo — a later pricing change must never
  // silently reprice something already in progress.
  priceKobo     Int
  paymentId     String?
  payment       Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  // Guardian consent (brief §6, "Data ownership and consent") — captured at
  // registration for anyone under 18, timestamped with the consenting
  // party's details. Nullable: only required/populated when the player is a
  // minor, enforced in PlayerRegistrationService against Player.dateOfBirth,
  // not at the schema level (the schema can't know the player's age at
  // constraint-check time without a computed column).
  guardianName      String?
  guardianPhone     String?
  guardianEmail     String?
  guardianConsentAt DateTime?

  // Set once status transitions to LOCKED (registration close) — after
  // this, the row itself is meant to be treated as immutable by application
  // code, same "correction not mutation" spirit as match_events, though not
  // DB-trigger-enforced here since the stakes (a wrong shirt number) don't
  // match match_events' tamper-evidence requirement.
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([competitionId, playerId])
  @@index([teamId])
  @@index([paymentId])
  @@map("player_registrations")
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

model Fixture {
  id            String        @id @default(uuid())
  competitionId String
  competition   Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homeTeamId    String
  homeTeam      Team          @relation("HomeFixtures", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId    String
  awayTeam      Team          @relation("AwayFixtures", fields: [awayTeamId], references: [id], onDelete: Cascade)
  kickoffAt     DateTime
  venueName     String?
  matchday      String?
  status        FixtureStatus @default(SCHEDULED)
  homeScore     Int?
  awayScore     Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Phase 4 (brief §5.1). attendanceCount: "recorder enters a figure at
  // half-time" — nullable, only ever set by a recorder action, never
  // inferred. chainVerified/verifiedAt: cached result of Phase 1's
  // verifyEventChain() replay, computed once in MatchEventsService's
  // existing FULL_TIME hook rather than re-replayed on every sponsor
  // dashboard load.
  attendanceCount Int?
  chainVerified   Boolean   @default(false)
  verifiedAt      DateTime?

  // The onDelete behavior lives on MatchEvent.fixture below (Restrict, not
  // Cascade): a fixture with recorded events can't be deleted out from under
  // its own immutable log. FixturesService.remove() checks this up front and
  // throws a clear error before Postgres ever would.
  matchEvents MatchEvent[]

  @@index([competitionId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([kickoffAt])
  @@map("fixtures")
}

enum MatchEventType {
  KICKOFF
  GOAL
  SHOT
  SHOT_ON_TARGET
  SHOT_OFF_TARGET
  SAVE
  CORNER
  FREE_KICK
  THROW_IN
  PENALTY_AWARDED
  PENALTY_SCORED
  PENALTY_MISSED
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  INJURY
  VAR_DECISION
  OFFSIDE
  HALF_TIME
  FULL_TIME
  // Append-only correction mechanism — see the comment in
  // packages/shared/src/match-event.ts.
  CORRECTION
  NOTE
}

model MatchEvent {
  id             String         @id @default(uuid())
  // Deliberately still a single global autoincrement, not renumbered to be
  // per-fixture (brief's schema wants unique(match_id, seq)). A global
  // monotonic value, filtered by fixtureId, still gives an unambiguous,
  // tamper-detectable per-match order — the same guarantee — without a live
  // renumbering migration on a table with real rows and concurrent writers.
  // Flagged in the Phase 1 report as a deliberate deviation, not an oversight.
  sequence       Int            @unique @default(autoincrement())
  fixtureId      String
  // Restrict, not Cascade (was Cascade before Phase 1): deleting a fixture
  // must not silently destroy its immutable event history.
  fixture        Fixture        @relation(fields: [fixtureId], references: [id], onDelete: Restrict)
  type           MatchEventType
  minute         Int
  stoppageMinute Int?
  teamId         String?
  team           Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  playerId       String?
  player         Player?        @relation("MatchEventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  assistPlayerId String?
  assistPlayer   Player?        @relation("MatchEventAssist", fields: [assistPlayerId], references: [id], onDelete: SetNull)
  metadata       Json?
  clientEventId  String
  // NOT NULL (was nullable before Phase 1) + Restrict (was SetNull): a
  // recorded event must always carry who recorded it, permanently — you
  // can't delete your way out of attribution. System-generated events (the
  // auto-kickoff job) are attributed to a seeded system user, not left null.
  recordedById   String
  recordedBy     User           @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  // Corrections: a mistake is a new CORRECTION-type row pointing back at the
  // event it corrects, never an edit or delete of the original. Only
  // meaningful when type = CORRECTION; enforced in MatchEventsService, not
  // at the DB level (Prisma/Postgres CHECK constraints referencing another
  // column's value by a fixed comparison work here, but conditional
  // "required if type=X" rules don't map cleanly to a CHECK — kept as
  // application-layer validation, same as the rest of this DTO's shape
  // rules).
  correctsEventId  String?
  correctsEvent    MatchEvent?  @relation("MatchEventCorrections", fields: [correctsEventId], references: [id], onDelete: Restrict)
  correctedBy      MatchEvent[] @relation("MatchEventCorrections")
  correctionReason String?

  // Hash chain — the actual tamper-evidence mechanism. hash = sha256(prevHash
  // + canonicalJson(row minus hash)); prevHash = hash of the previous event
  // for this fixture (by sequence order), or sha256(fixtureId) seeding the
  // first event of a match. Computed once at insert time in
  // MatchEventsService, never recomputed or edited after — see
  // src/modules/matches/domain/event-hash-chain.ts.
  prevHash String
  hash     String

  createdAt DateTime @default(now())

  @@unique([fixtureId, clientEventId])
  @@index([fixtureId])
  @@index([correctsEventId])
  @@map("match_events")
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

model NewsArticle {
  id            String     @id @default(uuid())
  title         String
  slug          String     @unique
  excerpt       String?
  body          String
  coverImageUrl String?
  status        NewsStatus @default(DRAFT)
  tags          String[]   @default([])
  authorId      String?
  author        User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@map("news_articles")
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

model Media {
  id           String    @id @default(uuid())
  key          String    @unique
  url          String
  filename     String
  mimeType     String
  sizeBytes    Int
  kind         MediaKind
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([kind])
  @@map("media")
}

// ===== Phase 2: payments (MONETISATION_BUILD_BRIEF.md §3.5-3.7) =====

enum PaymentProvider {
  PAYSTACK
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  ABANDONED
}

enum PaymentPurpose {
  LICENCE
  ONBOARDING
  PLAYER_REGISTRATION
  ACADEMY_PLAN
  ADD_ON
}

model Payment {
  id                String          @id @default(uuid())
  organisationId    String
  organisation      Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  // Our own reference, generated before ever calling Paystack — created
  // PENDING first, Paystack initialize called second (§3.5's flow), so this
  // always exists even if the Paystack call itself never completes.
  reference         String          @unique
  provider          PaymentProvider
  // Paystack's own reference once initialize/webhook gives us one; null for
  // BANK_TRANSFER/CASH until an admin fills it in when confirming.
  providerReference String?
  amountKobo        Int
  currency          String          @default("NGN")
  status            PaymentStatus   @default(PENDING)
  purpose           PaymentPurpose
  // Polymorphic pointer at whatever this payment is for (a PlayerRegistration
  // id, a Competition id for a licence fee, etc.) — deliberately not a typed
  // FK per subjectType, since purpose already enumerates the closed set of
  // things a payment can be for and a real FK per type would mean N nullable
  // FK columns for N purposes.
  subjectType       String
  subjectId         String
  paidAt            DateTime?
  rawResponse       Json?

  // Bank-transfer-specific fields (§3.6: "attach the transfer reference and
  // optionally a proof image, record who confirmed it") — the brief
  // describes this feature without listing these columns on its payments
  // sketch; added here to actually support it rather than leave it
  // unimplementable.
  confirmedById    String?
  confirmedBy      User?   @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  transferProofUrl String?
  transferNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerRegistrations  PlayerRegistration[]
  mediaPackEntitlement MediaPackEntitlement?

  @@index([organisationId])
  @@index([status])
  @@index([subjectType, subjectId])
  @@map("payments")
}

// Every webhook payload is stored raw BEFORE processing (§3.5) — "when
// something goes wrong at 9pm on a matchday you will need it." This table
// is deliberately append-only in spirit (never updated after processedAt is
// set) though not DB-trigger-enforced like match_events — a bad webhook
// payload isn't a business-critical tamper-evidence concern the way match
// results are.
model WebhookEvent {
  id                String    @id @default(uuid())
  provider          String
  eventType         String
  providerReference String?
  signatureValid    Boolean
  rawBody           String
  processedAt       DateTime?
  processingError   String?
  createdAt         DateTime  @default(now())

  @@index([provider, providerReference])
  @@map("webhook_events")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PART_PAID
  PAID
  CANCELLED
  EXPIRED
}

model Invoice {
  id             String        @id @default(uuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  // Human-readable, sequential (4EV-2026-0001) — generated from the
  // invoice_quote_seq Postgres sequence in the migration, formatted in
  // InvoicesService. "Organisers need them for their sponsor's records, and
  // looking institutional is worth money in this segment."
  quoteNumber    String        @unique
  status         InvoiceStatus @default(DRAFT)
  subtotalKobo   Int
  discountKobo   Int           @default(0)
  totalKobo      Int
  validUntil     DateTime?
  // Two milestones (50% on signature, 50% before first matchday per §3.7),
  // not one lump — both nullable since not every invoice uses a split
  // schedule.
  depositKobo    Int?
  balanceKobo    Int?
  issuedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines                      InvoiceLine[]
  academySubscription        AcademySubscription?
  academySubscriptionRequest AcademySubscriptionRequest?

  @@index([organisationId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  // What this line is priced against (e.g. "player" for a
  // per-player-registration line) — free text, mirrors the brief's `basis`
  // column exactly rather than a typed enum, since invoice line descriptions
  // are inherently freeform.
  basis       String?
  quantity    Int
  unitKobo    Int
  amountKobo  Int

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ===== Phase 3: the media engine (MONETISATION_BUILD_BRIEF.md §4) =====

enum GraphicTemplate {
  FULL_TIME_RESULT
  GOAL_ALERT
  MATCHDAY_FIXTURES
  LEAGUE_TABLE
  TOP_SCORERS
  PLAYER_OF_WEEK
  PLAYER_PASSPORT
  HEAD_TO_HEAD
  MILESTONE
  SEASON_SUMMARY
}

enum GraphicFormat {
  SQUARE // 1080x1080
  PORTRAIT // 1080x1350
  STORY // 1080x1920
}

enum GraphicStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// One row per rendered image, across all 10 templates — deliberately a
// single polymorphic table rather than one per template, since the
// enqueue -> render -> upload -> serve lifecycle is identical for all of
// them and a GraphicsWorkerService needs one queue to poll, not ten.
model Graphic {
  id       String          @id @default(uuid())
  template GraphicTemplate
  format   GraphicFormat
  status   GraphicStatus   @default(PENDING)

  // Scopes the graphic to a competition for branding (colours/sponsor
  // logo) and entitlement checks. Nullable: a PLAYER_PASSPORT is ungated
  // and a player can be registered to zero competitions.
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  // What data-domain entity this graphic is actually about — 'FIXTURE' |
  // 'PLAYER' | 'COMPETITION' | 'TEAM'. Not a typed FK per subject kind for
  // the same reason Payment.subjectType/subjectId isn't: the closed set of
  // template kinds already enumerates what a graphic can be about.
  subjectType String
  subjectId   String

  // Every field the renderer needs, captured at enqueue time. Makes
  // rendering a pure function of this JSON blob — no DB access mid-render,
  // deterministic, replayable, and unit-testable without a database.
  data Json

  mediaKey     String?
  publicUrl    String?
  attempts     Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  readyAt      DateTime?

  // Phase 4 (brief §5.1): "graphics shared" sponsor-dashboard metric.
  // Incremented each time the WhatsApp share-link endpoint is hit — a
  // share *intent*, not a confirmed share, since the native share sheet
  // itself is a client-side action invisible to this API.
  shareCount Int @default(0)

  @@index([status])
  @@index([subjectType, subjectId])
  @@index([competitionId])
  @@map("graphics")
}

// Grants access to the 9 gated templates (everything except
// PLAYER_PASSPORT, which is deliberately ungated — brief §4: "it is the
// acquisition loop"). competitionId null = the ADD_ONS.MEDIA_PACK_PER_CLUB
// SKU, granting every competition under the organisation; competitionId set
// = the ADD_ONS.MEDIA_PACK_COMPETITION SKU, scoped to one competition.
model MediaPackEntitlement {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  competitionId  String?
  competition    Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  // Restrict, not Cascade/SetNull: the payment that granted this is the
  // audit trail for why the organisation has it. Unique: fulfilPayment()
  // is idempotent (Phase 2 precedent) — replaying the same payment must
  // never create a second entitlement row.
  sourcePaymentId String   @unique
  sourcePayment   Payment  @relation(fields: [sourcePaymentId], references: [id], onDelete: Restrict)
  grantedAt       DateTime @default(now())

  @@index([organisationId])
  @@map("media_pack_entitlements")
}

// ===== Phase 4: sponsor reporting + academy workspace (MONETISATION_BUILD_BRIEF.md §5) =====

enum PlayerOutcomeType {
  TRIAL
  CALL_UP
  SIGNING
}

// "The number sponsors care about most and nobody else can produce it"
// (brief §5.1) — deliberately hand-entered, unlike every other
// sponsor-dashboard number, but WITH a mandatory source citation, which is
// what makes it auditable rather than a claimed/inflated figure. Same
// EDITOR-role convention as NewsArticle: curated content, not a derived
// metric.
model PlayerOutcome {
  id          String            @id @default(uuid())
  playerId    String
  player      Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type        PlayerOutcomeType
  description String
  sourceNote  String
  occurredAt  DateTime
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())

  @@index([playerId])
  @@map("player_outcomes")
}

enum SponsorFeature {
  IMPACT_REPORT
}

// Admin-granted, not self-serve purchased — brief §7: "Self-serve checkout
// and pricing pages before the tenth manual deal" is explicitly on the
// do-not-build list. An IMPACT_REPORT deal is closed manually; an admin
// records the grant here afterward. No sourcePayment FK (unlike
// MediaPackEntitlement) since there's deliberately no checkout flow behind
// this — `note` carries whatever the admin wants to record about the deal.
model SponsorEntitlement {
  id             String         @id @default(uuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  competitionId  String?
  competition    Competition?   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  feature        SponsorFeature
  grantedById    String
  grantedBy      User           @relation(fields: [grantedById], references: [id], onDelete: Restrict)
  note           String?
  grantedAt      DateTime       @default(now())

  @@index([organisationId])
  @@map("sponsor_entitlements")
}

model AcademyAgeGroup {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  minAge         Int?
  maxAge         Int?
  createdAt      DateTime     @default(now())

  teams      Team[]
  attendance AcademyAttendance[]

  @@unique([organisationId, name])
  @@map("academy_age_groups")
}

// "Four taps per player" (brief §5.2) — one tap = one status.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Same offline-sync idempotency pattern as MatchEvent (brief §5.2: "works
// offline, same sync mechanism as match capture") — clientEventId is the
// dedup key a flaky-connectivity retry resolves against, not a natural key
// on (ageGroupId, playerId, date), since a coach may legitimately correct
// an earlier tap by recording a new row rather than editing history, same
// "correction not mutation" spirit as match_events.
model AcademyAttendance {
  id             String           @id @default(uuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  ageGroupId     String
  ageGroup       AcademyAgeGroup  @relation(fields: [ageGroupId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  date           DateTime
  status         AttendanceStatus
  recordedById   String
  recordedBy     User             @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  clientEventId  String           @unique
  createdAt      DateTime         @default(now())

  @@index([ageGroupId, playerId])
  @@index([organisationId])
  @@map("academy_attendance")
}

enum AcademyPlanKey {
  STARTER
  GROWTH
  ELITE
}

// One row per year, append-only — a renewal is a new row, not a mutation
// of last year's, same precedent as Payment/Invoice records never being
// mutated after the fact. invoiceId is unique: exactly one subscription
// period per invoice.
model AcademySubscription {
  id             String         @id @default(uuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  planKey        AcademyPlanKey
  startDate      DateTime
  endDate        DateTime
  invoiceId      String         @unique
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())

  @@index([organisationId])
  @@map("academy_subscriptions")
}

// The gap between "an organiser chose a plan" and "we've actually been
// paid" — subscribe() used to create an AcademySubscription the instant a
// plan was chosen, with no payment step at all (a real reliability bug,
// flagged by the user directly). Now: choosing a plan creates the invoice
// and one of these rows; the AcademySubscription itself is only created
// once a platform admin confirms the invoice is paid (see
// AcademySubscriptionsService.confirmAndActivate()). activatedAt null =
// still awaiting confirmation; set once the linked AcademySubscription
// exists.
model AcademySubscriptionRequest {
  id             String         @id @default(uuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  planKey        AcademyPlanKey
  prepay         Boolean
  invoiceId      String         @unique
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  activatedAt    DateTime?
  createdAt      DateTime       @default(now())

  @@index([organisationId])
  @@map("academy_subscription_requests")
}
